%require_excel 'parameters.xlsx'

---
%resource 'roadsign'

obj=roadsign
%%addon excel!('addon') == '含'
%%ja excel!('japanese')
%%en excel!('english')
copyright=#{excel('copyright') || 'JP Historical Project'}

waytype=#{excel!('waytype') || 'road'}
free_route=#{excel('free_route') || 0}
single_way=#{excel('single_way') || 0}
is_signal=#{excel('is_signal') || 0}
min_speed=#{excel('min_speed') || 0}
offset_left=#{excel('offset_left') || 10}
cost=#{excel('cost') || 500}
maintenance=#{excel('maintenance') || 0}
intro_year=#{excel('intro_year') || 1}
intro_month=#{excel('intro_month') || 1}
retire_year=#{excel('retire_year') || 2999}
retire_month=#{excel('retire_month') || 1}
---
