%require '../../vehicles.datt'

---
name=Asuka_Kentoushi_Ship_Cargo
%include 'vehicle'
engine_type=sail
length=16
freightimagetype[0]=rice
freightimagetype[1]=pottery
freightimagetype[2]=salt
freightimagetype[3]=wood_fuel
freightimagetype[4]=fresh_fish
freightimagetype[5]=dried_fish
EmptyImage[s]=asuka_kentoushi_ship_cargo.0.0
EmptyImage[w]=asuka_kentoushi_ship_cargo.0.1
EmptyImage[sw]=asuka_kentoushi_ship_cargo.0.2
EmptyImage[se]=asuka_kentoushi_ship_cargo.0.3
EmptyImage[n]=asuka_kentoushi_ship_cargo.1.0
EmptyImage[e]=asuka_kentoushi_ship_cargo.1.1
EmptyImage[ne]=asuka_kentoushi_ship_cargo.1.2
EmptyImage[nw]=asuka_kentoushi_ship_cargo.1.3
%lines (0..5).map { |i| "FreightImage[#{i}][s]=asuka_kentoushi_ship_cargo.2.0\nFreightImage[#{i}][w]=asuka_kentoushi_ship_cargo.2.1\nFreightImage[#{i}][sw]=asuka_kentoushi_ship_cargo.2.2\nFreightImage[#{i}][se]=asuka_kentoushi_ship_cargo.2.3\nFreightImage[#{i}][n]=asuka_kentoushi_ship_cargo.3.0\nFreightImage[#{i}][e]=asuka_kentoushi_ship_cargo.3.1\nFreightImage[#{i}][ne]=asuka_kentoushi_ship_cargo.3.2\nFreightImage[#{i}][nw]=asuka_kentoushi_ship_cargo.3.3" }.join("\n")
---
