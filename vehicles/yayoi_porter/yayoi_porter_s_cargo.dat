obj=vehicle
name=Yayoi_Porter_Small_Cargo
copyright=Simutrans Yayoi Project
waytype=road

# --- economy -------------------------------------------------------------
# cost/runningcost are in cents; runningcost is per km.
# Omit intro_year and you silently get the engine default.
cost=12000
runningcost=4
intro_year=1
retire_year=2999

# --- physics -------------------------------------------------------------
# engine_type: steam|diesel|electric|bio|sail|hydrogene|fuel_cell|battery
# speed km/h, power kW (0 = unpowered wagon), gear % (100 = neutral),
# weight tonnes (empty), length in 1/16 of a tile (OBJECT_OFFSET_STEPS=16).
engine_type=bio
speed=6
power=5
gear=100
weight=1
length=4

# --- payload -------------------------------------------------------------
# freight: None|Passagiere|Post|<goods name>
freight=rice
payload=8
freightimagetype[0]=rice
# --- coupling ------------------------------------------------------------
# unconstrained: this vehicle couples to anything

# --- graphics (generated - do not hand-edit) -----------------------------
EmptyImage[s]=yayoi_porter_s_cargo.0.0
EmptyImage[w]=yayoi_porter_s_cargo.0.1
EmptyImage[sw]=yayoi_porter_s_cargo.0.2
EmptyImage[se]=yayoi_porter_s_cargo.0.3
EmptyImage[n]=yayoi_porter_s_cargo.1.0
EmptyImage[e]=yayoi_porter_s_cargo.1.1
EmptyImage[ne]=yayoi_porter_s_cargo.1.2
EmptyImage[nw]=yayoi_porter_s_cargo.1.3
FreightImage[0][s]=yayoi_porter_s_cargo.2.0
FreightImage[0][w]=yayoi_porter_s_cargo.2.1
FreightImage[0][sw]=yayoi_porter_s_cargo.2.2
FreightImage[0][se]=yayoi_porter_s_cargo.2.3
FreightImage[0][n]=yayoi_porter_s_cargo.3.0
FreightImage[0][e]=yayoi_porter_s_cargo.3.1
FreightImage[0][ne]=yayoi_porter_s_cargo.3.2
FreightImage[0][nw]=yayoi_porter_s_cargo.3.3
