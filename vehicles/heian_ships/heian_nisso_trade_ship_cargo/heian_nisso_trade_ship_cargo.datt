%require '../../vehicles.datt'

---
name=Heian_Nisso_Trade_Ship_Cargo
%include 'vehicle'
engine_type=sail
length=16
freightimagetype[0]=rice
freightimagetype[1]=millet
freightimagetype[2]=salt
freightimagetype[3]=dried_fish
freightimagetype[4]=sake
freightimagetype[5]=cured_meat
freightimagetype[6]=raw_meat
freightimagetype[7]=pottery
freightimagetype[8]=wood_fuel
freightimagetype[9]=raw_stone
freightimagetype[10]=stone_goods
freightimagetype[11]=iron_sand
freightimagetype[12]=crude_iron
freightimagetype[13]=ironware
freightimagetype[14]=fresh_fish
freightimagetype[15]=raw_fiber
freightimagetype[16]=textiles
freightimagetype[17]=paper
freightimagetype[18]=timber
freightimagetype[19]=lacquerware
EmptyImage[s]=heian_nisso_trade_ship_cargo.0.0
EmptyImage[w]=heian_nisso_trade_ship_cargo.0.1
EmptyImage[sw]=heian_nisso_trade_ship_cargo.0.2
EmptyImage[se]=heian_nisso_trade_ship_cargo.0.3
EmptyImage[n]=heian_nisso_trade_ship_cargo.1.0
EmptyImage[e]=heian_nisso_trade_ship_cargo.1.1
EmptyImage[ne]=heian_nisso_trade_ship_cargo.1.2
EmptyImage[nw]=heian_nisso_trade_ship_cargo.1.3
%lines (0..19).map { |i| "FreightImage[#{i}][s]=heian_nisso_trade_ship_cargo.2.0\nFreightImage[#{i}][w]=heian_nisso_trade_ship_cargo.2.1\nFreightImage[#{i}][sw]=heian_nisso_trade_ship_cargo.2.2\nFreightImage[#{i}][se]=heian_nisso_trade_ship_cargo.2.3\nFreightImage[#{i}][n]=heian_nisso_trade_ship_cargo.3.0\nFreightImage[#{i}][e]=heian_nisso_trade_ship_cargo.3.1\nFreightImage[#{i}][ne]=heian_nisso_trade_ship_cargo.3.2\nFreightImage[#{i}][nw]=heian_nisso_trade_ship_cargo.3.3" }.join("\n")
---
