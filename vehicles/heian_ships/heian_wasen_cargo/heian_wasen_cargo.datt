%require '../../vehicles.datt'

---
name=Heian_Wasen_Cargo
%include 'vehicle'
engine_type=sail
length=15
freightimagetype[0]=rice
freightimagetype[1]=pottery
freightimagetype[2]=salt
freightimagetype[3]=wood_fuel
freightimagetype[4]=fresh_fish
freightimagetype[5]=dried_fish
EmptyImage[s]=heian_wasen_cargo.0.0
EmptyImage[w]=heian_wasen_cargo.0.1
EmptyImage[sw]=heian_wasen_cargo.0.2
EmptyImage[se]=heian_wasen_cargo.0.3
EmptyImage[n]=heian_wasen_cargo.1.0
EmptyImage[e]=heian_wasen_cargo.1.1
EmptyImage[ne]=heian_wasen_cargo.1.2
EmptyImage[nw]=heian_wasen_cargo.1.3
%lines (0..5).map { |i| "FreightImage[#{i}][s]=heian_wasen_cargo.2.0\nFreightImage[#{i}][w]=heian_wasen_cargo.2.1\nFreightImage[#{i}][sw]=heian_wasen_cargo.2.2\nFreightImage[#{i}][se]=heian_wasen_cargo.2.3\nFreightImage[#{i}][n]=heian_wasen_cargo.3.0\nFreightImage[#{i}][e]=heian_wasen_cargo.3.1\nFreightImage[#{i}][ne]=heian_wasen_cargo.3.2\nFreightImage[#{i}][nw]=heian_wasen_cargo.3.3" }.join("\n")
---
