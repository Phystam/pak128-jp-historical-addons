%require_excel 'parameters.xlsx'

---
%resource 'way'

obj=way
%%addon excel!('addon') == '含'
%%ja excel!('japanese')
%%en excel!('english')
copyright=#{excel('copyright') || ''}

waytype=#{excel!('waytype')}
intro_year=#{excel('intro_year') || 1}
intro_month=#{excel('intro_month') || 1}
retire_year=#{excel('retire_year') || 2999}
retire_month=#{excel('retire_month') || 1}

topspeed=#{excel('topspeed') || 20}
max_weight=#{excel('max_weight') || 5}
cost=#{excel('cost') || 500}
maintenance=#{excel('maintenance') || 10}
wear_capacity=#{excel('wear_capacity') || 100000}
system_type=0
---
