%require_excel 'parameters.xlsx'

---
%resource 'depot'

obj=building
%%addon excel!('addon') == '含'
%%ja excel!('japanese')
%%en excel!('english')
copyright=#{excel('copyright') || 'JP Historical Project'}

type=#{excel!('type')}
waytype=#{excel('waytype') || 'road'}
level=#{excel('level') || 1}
intro_year=#{excel('intro_year') || 1}
intro_month=#{excel('intro_month') || 1}
retire_year=#{excel('retire_year') || 2999}
retire_month=#{excel('retire_month') || 1}

cost=#{excel('cost') || 1000}
maintenance=#{excel('maintenance') || 10}
needs_ground=#{excel('needs_ground') || 1}
---
