# Yayoi Rice Paddy Industry / Factory Addon (1x1, 4 Rotations x 5 Seasons including Snow)
# Features a raised-floor granary (高床式倉庫) and a pit-style farm tool storage shed (竪穴式農機具倉庫)
# surrounded by a wooden stake fence and 4-side irrigation canals that connect seamlessly with the rice paddies.
# Automatically spawns the 3 rice paddy variants in all 4 rotational orientations (12 field classes).
obj=factory
name=Yayoi_Suiden_Factory
copyright=Simutrans Yayoi Project
location=Land
mapcolor=162
productivity=20
range=10
distributionweight=5
dims=1,1,4
level=2
intro_year=1
intro_month=1
retire_year=2999
retire_month=1
needs_ground=1
